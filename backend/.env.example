# Copy to application-prod.properties values, or set as environment variables
# on your hosting platform (Render/Railway).

SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<db>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password
